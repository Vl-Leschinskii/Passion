{
  "name": "passion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "prod": "npm run build && npm run start",
    "gateway": "docker compose up -d gateway",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate dev --name init && tsx prisma/seed.ts",
    "sync:drive": "tsx scripts/sync-drive.ts",
    "drive:creds": "tsx scripts/apply-drive-credentials.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "googleapis": "^178.0.0",
    "mammoth": "^1.12.3",
    "next": "^15.5.25",
    "pdf-parse": "^1.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uuid": "^14.0.2",
    "word-extractor": "^1.0.4",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3"
  }
}
